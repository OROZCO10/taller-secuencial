Algoritmo  usodefunciones 
	definir  x, seno, coseno, tangente, rz, lgn, lgt como real
	escribir "ingresa x" 
	leer x
	seno = SEN(X)
	coseno = COS(X)
	tangente = TAN(X)
	rz = RAIZ(X)
	lgn = LN(X)
	lgt = Ln(X)/LN(10)
	IMPRIMIR  " x es" ,x 
	imprimir  "su seno es" ,seno  
	imprimir "su coseno es",coseno 
	imprimir  "su tangente es",tangente
	imprimir  "su rz es" ,rz
	imprimir  "su lgn es " ,lgn
	imprimir "su lgt es" ,lgt 
	
	
	
	
FinAlgoritmo
