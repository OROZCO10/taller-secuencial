Algoritmo promedioNotas
	definir n1, n2, n3, n4, promedio como real 
	escribir "ingresa n1"
	leer n1 
	escribir  "ingresa n2"
	leer n2 
	escribir "ingresa n3"
	leer n3
	escribir "ingresa n4" 
	leer n4
	promedio= (n1+n2+n3+n4)/4
	escribir "la nota definitiva es", promedio 
	
	
	
FinAlgoritmo
